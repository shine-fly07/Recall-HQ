# ===================================================================
# RecallHQ - Environment Configuration
# HackwithHyderabad 3.0 Production Configuration
# ===================================================================

# Vectorize Hindsight API Key & Bank ID (https://hindsight.vectorize.io/)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=recallhq_production_events

# Groq API Configuration (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
# LLM Provider: openai/gpt-oss-120b or qwen/qwen3-32b (with retry fallbacks)
GROQ_MODEL=openai/gpt-oss-120b

# Optional SQLite Database Path (Defaults to local ./data/events.json)
DATABASE_URL=file:./recallhq.db
